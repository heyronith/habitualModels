# Copy to .env (never commit .env). Modal auth is normally via `modal token set`
# or ~/.modal.toml; these are optional overrides.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Hugging Face (needed to download Qwen3 weights on Modal / locally)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Optional: override Modal app / volume names
HABIT_MODAL_APP=habitual-models
HABIT_VOLUME=habitual-checkpoints
